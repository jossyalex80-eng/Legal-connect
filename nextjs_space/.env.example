# ============================================================
# CALL LEGAL CONNECT — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# --- Database ---
# PostgreSQL connection string (get from your DB provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?connect_timeout=15

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
# Your app URL (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (optional) ---
# Get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- AWS S3 (file uploads) ---
AWS_PROFILE=hosted_storage
AWS_REGION=us-west-2
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_FOLDER_PREFIX=your-folder-prefix/
# If not using AWS profiles, set these instead:
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# --- Abacus AI (AI lawyer matching) ---
ABACUSAI_API_KEY=your_abacusai_api_key

# --- App Config ---
WEB_APP_ID=your_web_app_id
NOTIF_ID_CONTACT_FORM_SUBMISSION=your_notification_id
